# ---------------------------------------------------------------------------
# Backend API - host-only task runner (no Docker/Podman)
#
# Assumes Postgres and Redis are installed and running natively on this
# machine (e.g. `brew install postgresql redis`), and DATABASE_URL/REDIS_URL
# in .env point at localhost. Use: make -f Makefile.local <target>
# ---------------------------------------------------------------------------
SHELL          := /bin/bash
APP_NAME       ?= backend-api
BIN_DIR        ?= bin
MAIN_PKG       ?= ./cmd
MIGRATIONS_DIR ?= migrations

ifneq (,$(wildcard ./.env))
include .env
export
endif
DATABASE_URL ?= postgres://postgres:postgres@localhost:5432/appdb?sslmode=disable
REDIS_URL    ?= redis://localhost:6379/0

GIT_COMMIT := $(shell git rev-parse --short HEAD 2>/dev/null || echo "unknown")
BUILD_TIME := $(shell date -u +%Y-%m-%dT%H:%M:%SZ)
LDFLAGS    := -s -w -X main.version=$(GIT_COMMIT) -X main.buildTime=$(BUILD_TIME)

.DEFAULT_GOAL := help
.PHONY: help run build test test-integration test-cover lint fmt vet tidy sqlc \
        migrate migrate-down migrate-force migrate-create seed hooks clean

help: ## Show this help
	@grep -hE '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | \
	    awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-18s\033[0m %s\n", $$1, $$2}'

## --------------------------------------------------------------------------
## Development
## --------------------------------------------------------------------------
run: ## Run the API (requires postgres + redis already running and reachable at DATABASE_URL/REDIS_URL)
	go run $(MAIN_PKG)

build: ## Compile a static binary into ./bin
	@mkdir -p $(BIN_DIR)
	CGO_ENABLED=0 go build -trimpath -ldflags "$(LDFLAGS)" -o $(BIN_DIR)/$(APP_NAME) $(MAIN_PKG)

tidy: ## Sync go.mod / go.sum
	go mod tidy

fmt: ## Format the codebase
	go fmt ./...

vet: ## Run go vet
	go vet ./...

lint: ## Run golangci-lint
	golangci-lint run ./...

## --------------------------------------------------------------------------
## Testing
## --------------------------------------------------------------------------
test: ## Unit tests (fast, no external dependencies)
	go test -race -count=1 ./...

# NOTE: this is the one target that still needs a container runtime -
# testcontainers-go spins up disposable Postgres/Redis containers itself,
# regardless of how the app runs day to day. Needs Docker or Podman installed.
test-integration: ## Integration tests (spins up containers via testcontainers)
	go test -race -count=1 -tags=integration -timeout=10m ./tests/...

test-cover: ## Unit tests with an HTML coverage report
	go test -race -count=1 -coverprofile=coverage.out -covermode=atomic ./...
	go tool cover -html=coverage.out -o coverage.html
	@echo "report written to coverage.html"

## --------------------------------------------------------------------------
## Database
## --------------------------------------------------------------------------
sqlc: ## Regenerate type-safe query code from sql/queries
	sqlc generate

migrate: ## Apply all pending migrations
	migrate -path $(MIGRATIONS_DIR) -database "$(DATABASE_URL)" up

migrate-down: ## Roll back the most recent migration
	migrate -path $(MIGRATIONS_DIR) -database "$(DATABASE_URL)" down 1

migrate-force: ## Clear a dirty migration state: make -f Makefile.local migrate-force VERSION=1
	migrate -path $(MIGRATIONS_DIR) -database "$(DATABASE_URL)" force $(VERSION)

migrate-create: ## Scaffold a migration pair: make -f Makefile.local migrate-create NAME=add_widgets
	migrate create -ext sql -dir $(MIGRATIONS_DIR) -seq $(NAME)

seed: ## Insert the development seed data (admin + demo user)
	psql "$(DATABASE_URL)" -f scripts/seed.sql

## --------------------------------------------------------------------------
## Misc
## --------------------------------------------------------------------------
hooks: ## Install the pre-commit hooks
	pre-commit install

clean: ## Remove build and test artifacts
	rm -rf $(BIN_DIR) coverage.out coverage.html
