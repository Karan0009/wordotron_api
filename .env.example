# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | staging | production
APP_ENV=development
APP_NAME=backend-api
PORT=8080
# Vite dev server; used for password reset links
FRONTEND_URL=http://localhost:5173
RESET_PASSWORD_PATH=/reset-password
SHUTDOWN_TIMEOUT=15s
# 4 MiB max request body
BODY_LIMIT_BYTES=4194304
# comma separated CIDRs, empty = trust none
TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=debug
# text | json  (use json in production)
LOG_FORMAT=text

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/appdb?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Auth  (generate with: openssl rand -base64 48)
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-in-production-use-at-least-32-characters
JWT_EXPIRY=15m
REFRESH_SECRET=change-me-too-and-make-it-different-from-jwt-secret
# 30 days
REFRESH_EXPIRY=720h
JWT_ISSUER=backend-api
BCRYPT_COST=12
PASSWORD_RESET_EXPIRY=1h

# Mirror the refresh token into an HttpOnly cookie (recommended for the PWA).
REFRESH_COOKIE_ENABLED=false
COOKIE_DOMAIN=
# must be true in production (HTTPS only)
COOKIE_SECURE=false
# Strict | Lax | None
COOKIE_SAMESITE=Strict

# ---------------------------------------------------------------------------
# Sign in with Google
# ---------------------------------------------------------------------------
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application) and add the redirect URL below to its allow-list.
# Leave all three empty to turn the feature off; the API and the SPA both hide
# the button when it is not configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# ---------------------------------------------------------------------------
# CORS  (the Vite + React PWA origins)
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
CORS_ALLOW_CREDENTIALS=true

# ---------------------------------------------------------------------------
# Rate limiting (Redis backed, sliding window per IP)
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# requests per window (global)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1m
# requests per window on /auth/* endpoints
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1m

# ---------------------------------------------------------------------------
# Object storage: local | s3   (MinIO is S3-compatible -> use s3)
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/files
STORAGE_LOCAL_PATH=./.data/uploads
# 5 MiB
STORAGE_MAX_UPLOAD_BYTES=5242880

S3_BUCKET=app-uploads
S3_REGION=us-east-1
# e.g. http://minio:9000 for MinIO, empty for AWS
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# required for MinIO
S3_USE_PATH_STYLE=true
